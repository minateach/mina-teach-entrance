modules = ["web", "python-base-3.13", "nodejs-24", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server.mjs"]
build = ["npm", "run", "build:account"]

[userenv]

[userenv.shared]
FIREBASE_PROJECT_ID = "mina-teach-ai"
FIREBASE_AUTH_DOMAIN = "mina-teach-ai.firebaseapp.com"
FIREBASE_APP_ID = "1:136694073512:web:fecd1fb1ea4d183067da9d"
FIREBASE_MESSAGING_SENDER_ID = "Kanuma beekaa"
FIREBASE_MEASUREMENT_ID = "Hin argane"
